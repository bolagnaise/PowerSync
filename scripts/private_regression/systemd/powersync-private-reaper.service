[Unit]
Description=PowerSync private replay independent host reaper
After=docker.service

[Service]
Type=oneshot
User=powersync-regression
Group=docker
ExecStart=/opt/powersync-regression/venv/bin/python /opt/powersync-regression/scripts/private_regression/sandbox.py reap
NoNewPrivileges=true
LimitCORE=0
UMask=0077
