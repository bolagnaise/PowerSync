[Unit]
Description=PowerSync private replay independent host reaper
After=docker.service

[Service]
Type=oneshot
User=powersync-regression
Group=docker
EnvironmentFile=/etc/powersync-regression/host.env
ExecStart=/opt/powersync-regression/venv/bin/python /opt/powersync-regression/scripts/private_regression/sandbox.py reap ${POWERSYNC_DOCKER_ID}
NoNewPrivileges=true
LimitCORE=0
UMask=0077
